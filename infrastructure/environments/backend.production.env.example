DJANGO_SECRET_KEY=replace-with-a-generated-production-secret
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ALLOWED_HOSTS=backend,127.0.0.1,replace-with-approved-hostname
DATABASE_URL=mysql://sky:replace-with-url-encoded-production-password@mysql:3306/sky_commerce
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/1
CORS_ALLOWED_ORIGINS=https://replace-with-approved-hostname
CSRF_TRUSTED_ORIGINS=https://replace-with-approved-hostname
MEDIA_ROOT=/app/media
PRIVATE_MEDIA_ROOT=/app/private-media
MEDIA_UPLOAD_MAX_BYTES=5242880
MEDIA_MAX_PIXELS=16000000
MEDIA_MIN_FREE_BYTES=1073741824
MEDIA_WARN_FREE_BYTES=2147483648
MEDIA_MAX_STORAGE_BYTES=21474836480
MEDIA_MAX_ASSETS=10000
