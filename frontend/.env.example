NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MEDIA_ORIGIN=
# Optional server-to-server origin, e.g. http://backend:8000/api/v1 inside Docker.
API_INTERNAL_BASE_URL=

# Optional dev ASGI websocket origin, e.g. ws://localhost:8000/ws/chat/
# Production defaults to same-origin /ws/chat/ through Nginx.
NEXT_PUBLIC_CHAT_WS_URL=
